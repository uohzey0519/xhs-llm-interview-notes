# Optional local configuration for Xiaohongshu collection.
# Copy to `.env` and fill in your own values. `.env` is gitignored.

# Either set the full favorites page URL:
XHS_FAVORITES_URL="https://www.xiaohongshu.com/user/profile/<profile-id>?tab=fav&subTab=note"

# Or set only the profile id:
# XHS_PROFILE_ID="<profile-id>"

# Public output defaults hide personal favorite order and profile-note URLs.
# Set these to 1 only for private/local reports.
# XHS_INCLUDE_PERSONAL_ORDER=1
# XHS_INCLUDE_COLLECT_URL=1
